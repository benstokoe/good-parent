# Copy to .env.local and fill in real values.
#
# 1. Run `npx convex dev` — it creates a Convex project and writes
#    EXPO_PUBLIC_CONVEX_URL into .env.local for you.
# 2. Create a Clerk app (clerk.com), copy its publishable key below, and add a JWT
#    template named "convex" (Clerk dashboard → JWT templates) — its Issuer URL is
#    EXPO_PUBLIC_CLERK_ISSUER_URL, and is also used by convex/auth.config.ts.
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_ISSUER_URL=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZXhvdGljLW1hbW1hbC0yNDM4LmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_awGhcazPf75XqlarJ6ap28uAEW6EGFpvNP9EjedFMd
